## Basic-Aliasses

alias n='nvim'     # Run neovim
alias c="clear && printf '\e[3J'"          # Clear the terminal screen
alias conf='cd $HOME/.config/'             # Go to the config directory
alias nali='nvim $HOME/.config/aliasrc'    # Open the alias file


## ─────────────────────────────────────────────────────────────────────────────
## Kitty-Protocol

alias show='kitty +kitten icat'    # Show images in the kitty terminal


## ─────────────────────────────────────────────────────────────────────────────
## Interwebz

alias ing="xdg-open https://mijn.ing.nl/login/"                     # Log in private
alias ingb="xdg-open https://https://mijnzakelijk.ing.nl/login/"    # Log in business


## ─────────────────────────────────────────────────────────────────────────────
## Commands

alias wget='wget --hsts-file="$XDG_STATE_HOME/wget-hsts'
alias bat='echo -e "this was run by a script [bat = batcat]\n" && batcat'       # Cat replacement
alias calc='qalc'        # Run the calculator
alias cp='cp -ir'        # Copy a file or directory
alias df='df_logic'     # Free disk space || size current folder
alias h='history'        # Show the history
alias ls='lsa'           # ls
alias tree='eza -A --tree --icons=always'
alias mv='mv -i'         # Move a file or directory
alias news='newsboat'    # Newsboat
alias sxiv='nsxiv'       # nsxiv
alias repgrep='rgr'      # Repgrep
alias ripgrep='rg'       # Ripgrep
alias rm='rm -rfi'       # Remove a file or directory
# alias diff='diff -EBwZby --color=auto'    # Difference between files
alias yt-dlp='$HOME/Documents/scripts/yt-dlp.sh'


